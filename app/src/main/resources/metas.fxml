<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="planejadorfinanceiro.MetasController">

    <VBox alignment="CENTER" maxWidth="900" prefWidth="900" spacing="15"
          AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
          AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

        <padding>
            <Insets bottom="20" left="20" right="20" top="20" />
        </padding>

        <!-- Título -->
        <Label alignment="CENTER" style="-fx-font-size: 20px; -fx-font-weight: bold;"
               text="Suas Metas" textAlignment="CENTER" />

        <!-- Dica de interação -->
        <Label text="Dica: clique duas vezes em uma meta para atualizar seu saldo."
            style="-fx-text-fill: #2c3e50; -fx-font-size: 13px; -fx-font-weight: bold;" />





        <!-- Tabela de Metas -->
        <TableView fx:id="tabelaMetas" maxWidth="800" prefHeight="600" prefWidth="800">
            <columns>
                <TableColumn fx:id="colunaNome" maxWidth="200.0" minWidth="200.0" prefWidth="200" text="Nome" />
                <TableColumn fx:id="colunaValorAlvo" maxWidth="150.0" minWidth="150.0" prefWidth="150" text="Valor Alvo (R$)" />
                <TableColumn fx:id="colunaValorAtual" maxWidth="150.0" minWidth="150.0" prefWidth="150" text="Valor Atual (R$)" />
                <TableColumn fx:id="colunaProgresso" maxWidth="150.0" minWidth="150.0" prefWidth="150" text="Progresso (%)" />
                <TableColumn fx:id="colunaPrazo" maxWidth="150.0" minWidth="150.0" prefWidth="150" text="Prazo Final" />
            </columns>
        </TableView>

        <!-- Mensagens (sucesso/erro) -->
        <Label fx:id="messageLabel" text="" style="-fx-text-fill: green; -fx-font-weight: bold;" />

        <!-- Botões -->
        <HBox alignment="CENTER" spacing="20">
            <Button fx:id="voltarButton" text="Voltar" onAction="#handleVoltar"
                    style="-fx-background-color: #ecf0f1; -fx-text-fill: #2c3e50;
                           -fx-font-weight: bold; -fx-background-radius: 8;" />

            <Button fx:id="novaMetaButton" text="Criar nova meta" onAction="#handleCriarMeta"
                    style="-fx-background-color: #85c1e9; -fx-text-fill: #2c3e50;
                           -fx-font-weight: bold; -fx-background-radius: 8;" />

            
            <Button fx:id="excluirMetaButton" text="Excluir meta" onAction="#handleExcluirMeta"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white;
                           -fx-font-weight: bold; -fx-background-radius: 8;" />
        </HBox>
    </VBox>
</AnchorPane>
