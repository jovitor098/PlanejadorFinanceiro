<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import planejadorfinanceiro.ui.componentes.*?>

<ScrollPane fitToWidth="true" prefHeight="681.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="planejadorfinanceiro.TransacoesController">
    <VBox alignment="CENTER" spacing="15" style="-fx-padding: 20;">
        <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Todas as transações" />
        <FlowPane hgap="30.0" vgap="20.0" style="-fx-border-color: #bdc3c7; -fx-border-width: 1; -fx-border-radius: 8; -fx-padding: 10; -fx-background-radius: 8;">
            <TextField fx:id="nomeTextField" promptText="Nome:" />
            <HBox alignment="CENTER" spacing="5">
                <TextField fx:id="valorMinField" maxWidth="100" promptText="Mínimo (R$)" />
                <Label text="-" />
                <TextField fx:id="valorMaxField" maxWidth="100" promptText="Máximo (R$)" />
              </HBox>
         <HBox alignment="CENTER" spacing="10.0">
             <CheckBox fx:id="entradaCheckBox" mnemonicParsing="false" selected="true" text="Entrada" />
             <CheckBox fx:id="saidaCheckBox" mnemonicParsing="false" selected="true" text="Saída" />
         </HBox>
         <HBox spacing="10.0">
             <Label text="De" />
             <DatePicker fx:id="dataInicioPicker" prefWidth="120" promptText="Início" />
             <Label text="até" />
             <DatePicker fx:id="dataFimPicker" prefWidth="120" promptText="Fim" />
         </HBox>
         <Button mnemonicParsing="false" text="Filtrar" onAction="#handleFiltrar" style="-fx-background-color: #5dade2; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;" />
        </FlowPane>
        <TabelaTransacao fx:id="tabelaTransacao">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TabelaTransacao>
        <HBox alignment="CENTER" spacing="10">
            <Button fx:id="voltarButton" onAction="#handleVoltar" text="Voltar" style="-fx-background-color: #ecf0f1; -fx-text-fill: #2c3e50; -fx-font-weight: bold; -fx-background-radius: 8;" />
        </HBox>
    </VBox>
</ScrollPane>
